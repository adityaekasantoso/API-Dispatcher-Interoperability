# Koneksi database (connection pool)
db_pool = None
db_pool_lock = threading.Lock()


def get_pool():
    global db_pool

    with db_pool_lock:
        if db_pool is None:
            db_pool = ThreadedConnectionPool(
                1,
                30,
                host=DB_HOST,
                port=DB_PORT,
                dbname=DB_NAME,
                user=DB_USER,
                password=DB_PASSWORD,
                connect_timeout=10
            )

        return db_pool


def db_execute(sql, params=None, fetch=False):
    # Jalankan satu query lalu commit
    pool = get_pool()
    conn = pool.getconn()

    try:
        with conn.cursor() as cur:
            cur.execute(sql, params)

            rows = cur.fetchall() if fetch else None

        conn.commit()

        return rows

    except Exception:
        try:
            conn.rollback()
        except Exception:
            pass

        raise

    finally:
        pool.putconn(conn, close=bool(conn.closed))


def execute_with_retry(func, retries=5, delay=0.5):
    last_error = None

    for i in range(retries):
        try:
            return func()

        except psycopg2.OperationalError as e:
            last_error = e
            time.sleep(delay * (i + 1))

    print(f"[DB ERROR] Max retry reached: {last_error}")

    return None


# Fungsi bantu
def now_utc():
    return datetime.now(timezone.utc).strftime(
        "%Y-%m-%d %H:%M:%S"
    )


def clean_text(value):
    # Bersihkan string AIS
    if value is None:
        return None

    try:
        value = str(value)
    except Exception:
        return None

    value = value.replace("@", " ")
    value = value.replace("\x00", "")
    value = value.strip()

    if not value:
        return None

    return value


def clean_shipname(value):
    value = clean_text(value)

    if not value:
        return None

    value = value.replace("/", " ").strip()

    if not value:
        return None

    return value


def to_float(value, default=None):
    try:
        if value is None:
            return default

        return float(value)

    except Exception:
        return default


def to_int(value, default=None):
    try:
        if value is None:
            return default

        return int(value)

    except Exception:
        return default


def lookup_nav_status(code):
    try:
        return NAV_STATUS.get(
            int(code),
            "Unknown"
        )
    except Exception:
        return "Unknown"


def lookup_ship_type(code):
    try:
        return SHIP_TYPE.get(
            int(code),
            "Unknown"
        )
    except Exception:
        return "Unknown"


def lookup_country(mmsi):
    try:
        mid = str(mmsi)[:3]

        return COUNTRY.get(
            mid,
            "UNKNOWN"
        )

    except Exception:
        return "UNKNOWN"


