# Parsing AIS
def get_data_value(data, *names):
    # Ambil field dari beberapa kemungkinan nama
    for name in names:
        if name in data:
            value = data.get(name)

            if value is not None:
                return value

    return None


def parse_ais_sentence(sentence):
    # Decode satu pesan AIS yang sudah lengkap
    try:
        if not sentence:
            return None

        sentence = sentence.strip()

        if not sentence.startswith("!"):
            return None

        msg = decode(
            sentence,
            error_if_checksum_invalid=False
        )

        data = msg.asdict()

        msg_type = to_int(
            get_data_value(
                data,
                "msg_type",
                "message_type"
            )
        )

        if msg_type not in VALID_MSG_TYPES:
            return None

        mmsi = get_data_value(
            data,
            "mmsi"
        )

        if not mmsi:
            return None

        mmsi = str(mmsi)

        # Posisi
        lat = get_data_value(
            data,
            "lat",
            "latitude"
        )

        lon = get_data_value(
            data,
            "lon",
            "longitude"
        )

        speed = get_data_value(
            data,
            "speed",
            "sog"
        )

        course = get_data_value(
            data,
            "course",
            "cog"
        )

        heading = get_data_value(
            data,
            "heading",
            "true_heading"
        )

        # Data statis
        shipname = get_data_value(
            data,
            "shipname",
            "ship_name",
            "name"
        )

        callsign = get_data_value(
            data,
            "callsign",
            "call_sign"
        )

        destination = get_data_value(
            data,
            "destination"
        )

        imo = get_data_value(
            data,
            "imo"
        )

        ship_type = get_data_value(
            data,
            "ship_type",
            "shiptype"
        )

        status = get_data_value(
            data,
            "status",
            "nav_status"
        )

        part = get_data_value(
            data,
            "part",
            "part_number"
        )

        # Type 24: jangan hapus data hanya karena field tertentu None
        if msg_type == 24:

            if shipname is not None:
                shipname = clean_shipname(shipname)

            if callsign is not None:
                callsign = clean_text(callsign)

            if destination is not None:
                destination = clean_text(destination)

        else:

            shipname = clean_shipname(shipname)
            callsign = clean_text(callsign)
            destination = clean_text(destination)

        result = {
            "mmsi": mmsi,
            "message_type": msg_type,

            "lat": to_float(lat),
            "lon": to_float(lon),

            "speed": to_float(speed),
            "course": to_float(course),
            "heading": to_float(heading),

            "shipname": shipname,
            "callsign": callsign,
            "destination": destination,

            "country": lookup_country(mmsi),

            "imo": imo,
            "ship_type": to_int(ship_type),
            "status": to_int(status),

            "part": part,

            "last_seen": now_utc(),

            "_raw": data,
        }

        return result

    except Exception as e:
        print(
            f"[AIS PARSE ERROR] "
            f"{sentence} -> {e}"
        )

        return None


# Gabungkan fragment AIS
def process_ais_line(line):

    line = line.strip()

    if not line:
        return None

    if not line.startswith("!"):
        return None

    try:
        parts = line.split(",")

        if len(parts) < 7:
            return None

        fragment_count = int(parts[1])
        fragment_number = int(parts[2])
        sequence_id = parts[3].strip()
        channel = parts[4].strip()

        # Pesan tunggal
        if fragment_count == 1:
            return parse_ais_sentence(line)

        # Pesan multi fragment
        if not sequence_id:
            sequence_id = f"NOSEQ_{channel}"

        key = (
            f"{channel}:"
            f"{sequence_id}"
        )

        now = time.time()

        with ais_fragments_lock:

            # Hapus fragment lama
            expired = []

            for k, item in ais_fragments.items():
                if (
                    now - item["time"]
                    > FRAGMENT_TIMEOUT
                ):
                    expired.append(k)

            for k in expired:
                del ais_fragments[k]

            if key not in ais_fragments:
                ais_fragments[key] = {
                    "time": now,
                    "total": fragment_count,
                    "parts": {}
                }

            item = ais_fragments[key]

            item["time"] = now
            item["total"] = fragment_count

            item["parts"][fragment_number] = line

            # Belum lengkap
            if len(item["parts"]) < fragment_count:
                return None

            # Semua fragment sudah ada
            complete_parts = []

            for n in range(
                1,
                fragment_count + 1
            ):

                if n not in item["parts"]:
                    return None

                complete_parts.append(
                    item["parts"][n]
                )

            del ais_fragments[key]

        # Gabungkan payload jadi satu sentence baru
        try:
            first = complete_parts[0].split(",")

            last = complete_parts[-1].split(",")

            payloads = []

            for p in complete_parts:
                pparts = p.split(",")

                if len(pparts) >= 7:
                    payloads.append(
                        pparts[5]
                    )

            combined_payload = "".join(
                payloads
            )

            fill_bits = last[6]

            prefix = first[0]

            base = (
                f"{prefix},1,1,,A,"
                f"{combined_payload},"
                f"{fill_bits}"
            )

            # Hitung checksum baru
            checksum = 0

            for char in base[1:]:
                checksum ^= ord(char)

            sentence = (
                f"{base}*"
                f"{checksum:02X}"
            )

            return parse_ais_sentence(
                sentence
            )

        except Exception as e:
            print(
                f"[AIS FRAGMENT ERROR] "
                f"{key} -> {e}"
            )

            return None

    except Exception as e:
        print(
            f"[AIS LINE ERROR] "
            f"{line} -> {e}"
        )

        return None


# Simpan kapal ke ships (nilai None tidak menimpa data lama)
def upsert_snapshot(info):

    if not info:
        return

    mmsi = info.get("mmsi")

    if not mmsi:
        return

    ship_type_code = info.get("ship_type")

    ship_type = (
        lookup_ship_type(ship_type_code)
        if ship_type_code is not None
        else None
    )

    status_code = info.get("status")

    nav_stat = (
        lookup_nav_status(status_code)
        if status_code is not None
        else None
    )

    country = info.get("country")

    if country == "UNKNOWN":
        country = None

    imo = info.get("imo")

    imo = str(imo) if imo else None

    params = (
        mmsi,
        info.get("message_type"),
        info.get("shipname"),
        ship_type,
        nav_stat,
        country,
        info.get("destination"),
        info.get("lat"),
        info.get("lon"),
        info.get("speed"),
