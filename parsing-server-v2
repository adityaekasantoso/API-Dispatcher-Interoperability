# AIS TCP worker
def tcp_worker(ip, port):

    while True:

        client = None

        try:

            client = socket.socket(
                socket.AF_INET,
                socket.SOCK_STREAM
            )

            client.settimeout(
                SOCKET_RECV_TIMEOUT
            )

            client.setsockopt(
                socket.SOL_SOCKET,
                socket.SO_KEEPALIVE,
                1
            )

            client.connect(
                (ip, port)
            )

            print(
                f"[AIS CONNECTED] "
                f"{ip}:{port}"
            )

            buffer = ""

            while True:

                try:

                    chunk = client.recv(
                        BUFFER_SIZE
                    )

                except socket.timeout:
                    continue

                if not chunk:

                    print(
                        f"[AIS DISCONNECTED] "
                        f"{ip}:{port}"
                    )

                    break

                buffer += chunk.decode(
                    "ascii",
                    errors="ignore"
                )

                # Proses per baris
                while "\n" in buffer:

                    line, buffer = (
                        buffer.split(
                            "\n",
                            1
                        )
                    )

                    line = line.strip()

                    if not line:
                        continue

                    if (
                        line.startswith(
                            "!AIVDM"
                        )
                        or line.startswith(
                            "!AIVDO"
                        )
                    ):

                        info = process_ais_line(
                            line
                        )

                        if info:

                            # Debug pesan statis
                            if (
                                info.get(
                                    "message_type"
                                )
                                in STATIC_MSG_TYPES
                            ):

                                print(
                                    "[AIS STATIC]",
                                    info.get(
                                        "message_type"
                                    ),
                                    info.get(
                                        "mmsi"
                                    ),
                                    repr(
                                        info.get(
                                            "shipname"
                                        )
                                    ),
                                    repr(
                                        info.get(
                                            "callsign"
                                        )
                                    )
                                )

                            upsert_snapshot(info)

        except Exception as e:

            print(
                f"[AIS ERROR] "
                f"{ip}:{port} "
                f"{e}"
            )

        finally:

            if client:

                try:
                    client.close()
                except Exception:
                    pass

        time.sleep(5)


