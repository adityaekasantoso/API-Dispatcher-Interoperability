                url,
                timeout=3
            )

            response.raise_for_status()

            data = response.json()

            aircraft = data.get(
                "aircraft",
                []
            )

            if not isinstance(
                aircraft,
                list
            ):
                time.sleep(1)
                continue

            for ac in aircraft:

                if (
                    isinstance(ac, dict)
                    and ac.get("flight")
                ):
                    upsert_aircraft(ac)

        except Exception as e:

            print(
                f"[ADSB ERROR] "
                f"{url} {e}"
            )

        time.sleep(0.5)


