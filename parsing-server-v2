def load_radio_sources():
    result = []

    for s in config.get(
        "radio",
        "sources",
        fallback=""
    ).split(","):

        s = s.strip()

        if not s:
            continue

        if "|" in s:
            try:
                url, cred = s.split("|", 1)
                username, password = cred.split(":", 1)

                result.append(
                    (
                        url.strip(),
                        username.strip(),
                        password.strip()
                    )
                )

            except Exception as e:
                print(
                    f"[RADIO CONFIG ERROR] "
                    f"{s} -> {e}"
                )

        else:
            result.append(
                (
                    s,
                    None,
                    None
                )
            )

    return result


def load_ais_sources():
    result = []

    if not config.has_section("ais"):
        print(
            "[AIS] Section [ais] "
            "tidak ditemukan"
        )

        return result

    for s in config.get(
        "ais",
        "sources",
        fallback=""
    ).split(","):

        s = s.strip()

        if not s:
            continue

        try:
            ip, port = s.rsplit(":", 1)

            result.append(
                (
                    ip.strip(),
                    int(port.strip())
                )
            )

        except Exception as e:
            print(
                f"[AIS CONFIG ERROR] "
                f"{s} -> {e}"
            )

    return result


